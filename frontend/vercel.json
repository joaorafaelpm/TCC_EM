{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://engines-luxury-flood-sites.trycloudflare.com/auth/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://engines-luxury-flood-sites.trycloudflare.com/oauth2/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://engines-luxury-flood-sites.trycloudflare.com/v1/:path*"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "https://engines-luxury-flood-sites.trycloudflare.com/.well-known/:path*"
    },
    {
      "source": "/login",
      "destination": "https://engines-luxury-flood-sites.trycloudflare.com/login"
    },
    {
      "source": "/logout",
      "destination": "https://engines-luxury-flood-sites.trycloudflare.com/logout"
    },
    {
      "source": "/images/logo.svg",
      "destination": "https://engines-luxury-flood-sites.trycloudflare.com/images/logo.svg"
    },
    {
      "source": "/images/background.png",
      "destination": "https://engines-luxury-flood-sites.trycloudflare.com/images/background.png"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
